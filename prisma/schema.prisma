generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

model Card {
  id         Int      @id @default(autoincrement())
  title      String
  categories String[]
  desc       String
  done       Boolean  @default(false)
  group      String
}
